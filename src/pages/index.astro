---
import MainLayout from '../layouts/MainLayout.astro';
import CustomTitle from '../components/CustomTitle.astro';
const title = 'Home Page';
const name = "Jhon Gómez";
---

<MainLayout {title}>
	<h1>Hola, {name}!</h1>
	<CustomTitle title={title} />
	
	<p>Momento actual: {new Date().toLocaleTimeString()}</p>
	<p id="current-time">Momento actual real: </p>
	<script>
		const currentTime = document.querySelector('#current-time') as HTMLParagraphElement;
		currentTime.innerHTML = `Momento actual real: ${new Date().toLocaleTimeString()}`;
	</script>
</MainLayout>